# macOS
.DS_Store
*.swp

# Swift / SPM
.build/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
Package.resolved

# Kestrel runtime (nikdy necommitovat data uživatele)
.kestrel/
vault/
snapshots/
audit.log
# ...ale runtime pravidlo `vault/` omylem stínilo ZDROJOVÝ adresář — nikdy neignoruj zdrojáky:
!Sources/KestrelCore/Vault/
!Sources/KestrelCore/Vault/**

# Third-party engine data (velké, generované)
Resources/clamav-db/
Resources/yara-rules/*.compiled

# Secrets / signing
*.p12
*.provisionprofile
notarize-credentials*

# Packaged app bundle
dist/

# Agent worktrees
.claude/
