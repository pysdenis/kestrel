{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift: build",
      "type": "shell",
      "command": "swift build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "swift: run tests",
      "type": "shell",
      "command": "swift run kestrel-tests",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "swift: scan ~/Downloads (read-only)",
      "type": "shell",
      "command": "swift run kestrel scan ~/Downloads",
      "problemMatcher": []
    }
  ]
}
